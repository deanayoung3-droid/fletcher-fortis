# Paste into Portainer > Stacks > (stack) > Environment variables > "Advanced mode", then fill in.
DOMAIN=app.example.com
IMAGE=ghcr.io/deanayoung3-droid/fletcher-fortis:latest
# Fallback (built from the source tarball, no registry): IMAGE=localhost/fletcher-fortis:latest
# Optional one-click updates: add autoupdate to COMPOSE_PROFILES and set a long random token (same value is used by the app)
WATCHTOWER_TOKEN=
DRY_RUN=true
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=paste-token-from-cloudflare-zero-trust
APP_BIND=127.0.0.1
APP_PORT=8080

# Secrets. Generate each with:  openssl rand -base64 48
FF_DATA_KEY=
ADMIN_USERNAME=          # optional; empty = first-run setup wizard
ADMIN_PASSWORD=
INBOUND_SECRET=

# Sending (Resend, authorized-agent address). Leave the key empty until the domain is verified.
SEND_PROVIDER=resend
RESEND_API_KEY=
FROM_ADDRESS=privacy@example.com   # one shared sender for now; per-person reply address unlocks once a key is set
FROM_NAME=Fletcher Fortis Privacy
INBOUND_AUTOCLICK=true

# Deep scan pacing (per person, per site)
SCAN_DELAY_MS=8000
SCAN_MAX_QUERIES_PER_SITE=6
SCAN_MAX_PAGES=2
SCAN_MAX_DETAILS=3
SUMMARY_TO=
# Weekly summary (Monday 08:00 Pacific). Only sends when RESEND_API_KEY is set AND DRY_RUN=false.
SUMMARY_ENABLED=true
SUMMARY_HOUR=8
TZ=America/Los_Angeles

# Optional, off by default
PROXY_URL=
MAIL_FILTER_ENABLED=false
TWILIO_ENABLED=false
TWILIO_AUTH_TOKEN=
