# Optional. Everything below can also be set in the app (Heartbeat > Settings), which overrides these.
# Copy to .env only if you prefer environment configuration.
DRY_RUN=true                       # nothing is emailed or submitted while true
# FF_DATA_KEY=                     # 48+ random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
                                   # if unset, a key is generated inside the data volume (back it up!)
# ADMIN_USERNAME= / ADMIN_PASSWORD=   # optional: skip the setup wizard and create the admin on first boot
# PUBLIC_URL=https://privacy.example.com
# DOMAIN=privacy.example.com       # used by the optional Caddy (HTTPS) profile
# RESEND_API_KEY=
# FROM_ADDRESS=privacy@example.com
# INBOUND_SECRET=
# TZ=America/New_York
# ---- scanning ----
SCAN_ENABLED=true
SCAN_DAY=6                         # 0=Mon..6=Sun
SCAN_HOUR=3
SCAN_DELAY_MS=8000
# PROXY_URL=                       # optional bring-your-own residential proxy
# ---- optional Twilio screening number ----
TWILIO_ENABLED=false
# CALL_FORWARD_TO=+15555550100
# CALL_ALLOWLIST=+15555550101,+15555550102
